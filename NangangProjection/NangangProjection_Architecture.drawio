        <mxCell id="data_bg" value="資料定義層 Core/ — ScriptableObject（各層共享，不含邏輯）" style="text;html=1;strokeColor=#23445d;fillColor=#647687;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;overflow=hidden;rotatable=0;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
