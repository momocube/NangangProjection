        <mxCell id="d_hw"    value="SensorHardwareConst&#xa;CellPxW=16, CellPxH=32, Polling=100ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;strokeColor=#23445d;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1680" y="185" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="d_face"  value="SensorFaceConfig&#xa;origin, colCount/rowCount, flip, rawMin/Max&#xa;ContainsRaw / RawToPixel / PixelToCell" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;strokeColor=#23445d;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1680" y="248" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="d_canvas" value="DisplayCanvasConfig&#xa;canvasWidth × canvasHeight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;strokeColor=#23445d;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1680" y="322" width="320" height="46" as="geometry" /></mxCell>
        <mxCell id="d_venue" value="VenuePresetConfig&#xa;DisplayCanvasConfig + SensorFaceConfig[] + VCellMode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;strokeColor=#23445d;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1680" y="382" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="d_profile" value="SceneInitialSettingsProfile&#xa;UDP port、點擊模式、各功能開關" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;strokeColor=#23445d;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1680" y="446" width="320" height="50" as="geometry" /></mxCell>

