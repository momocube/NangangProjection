        <!-- ── DEPENDENCY RULE NOTE ── -->
        <mxCell id="dep_note" value="⚠️ 依賴方向（禁止反向）：Core ← Input ← Sensor ← Bus ← { Visual / Simulator / Game }&#xa;Visual 不可直接呼叫 Simulator，Simulator 不可直接呼叫 Visual — 跨層通訊一律透過 SensorBus / VirtualCellBus" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1090" width="1600" height="48" as="geometry" />
        </mxCell>

